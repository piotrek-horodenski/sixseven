{
  "include": ["app/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
		"target": "ES6",
    "lib": [
      "ES2021"
    ],
    "paths": {
      "@/*": [
        "./app/*"
      ]
    },
    "rootDir": "./app",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
		"sourceMap": true
  }
}
