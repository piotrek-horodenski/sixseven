{
  "name": "sixseven",
  "version": "0.0.1",
  "private": true,
  "description": "sixseven turn-based games platform monorepo",
  "workspaces": [
    "gate",
    "web",
    "image",
    "games",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:gate": "npm run test --workspace gate",
    "test:games": "npm run test --workspace games",
    "test:web": "npm run test --workspace web",
    "build": "npm run build --workspaces --if-present",
    "dev": "node dev-runner.js",
    "secret:generate": "node scripts/gen-secret.js",
    "secret:print": "node scripts/gen-secret.js --print"
  },
  "license": "ISC"
}
