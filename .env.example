# sixseven — zmienne środowiskowe (root, dla docker-compose).
# Skopiuj do .env i uzupełnij. .env jest w .gitignore — NIGDY nie commituj sekretów.
# Wygeneruj JWT_SECRET: npm run secret:generate  (lub: openssl rand -base64 48)

# Adres LAN maszyny (żeby telefon/inny sprzęt w sieci trafił w gate). Zostaw
# puste = localhost (tylko ta maszyna). Sprawdź: Windows `ipconfig` → IPv4 karty
# WiFi (np. 192.168.0.42). Po zmianie: przebuduj web (adres jest wkompilowany).
HOST_IP=
# TLS bramki: false = zwykły HTTP/WS (dev/LAN, telefon bez akceptowania certu).
# true = HTTPS/WSS (wymaga certów w cfg/cert). Domyślnie false dla wygody dev.
GATE_TLS=false

# Sekret JWT współdzielony przez gate i image (image weryfikuje tokeny gate).
# Rotacja unieważnia wszystkie aktywne sesje — patrz scripts/rotate-secret.sh.
JWT_SECRET=

# --- gate ---
GATE_PORT=4114
WEB_URL=http://localhost:5273
MONGODB_URI=mongodb://hydra-mongo1:27017/hydra?directConnection=true
JWT_EXPIRES_IN=7d
# Proxy komend gate→games (2c/2d). W docker-compose GAMES_URL jest ustawiany na
# http://games:4120 wprost w usłudze; INTERNAL_SECRET MUSI być identyczny w gate
# i games — dlatego bierzemy go stąd (podstawiany do obu usług).
INTERNAL_SECRET=dev-internal-secret-change-me

# --- games / rps (2d) ---
# Sekret HMAC platforma(games)→serwis RPS. MUSI być identyczny w usłudze `rps`
# (SIXSEVEN_GAME_SECRET) i w rejestracji RPS (games-register). W dev dowolny,
# w prod: openssl rand -base64 48.
RPS_HMAC_SECRET=dev-rps-hmac-secret-change-me

# --- image ---
IMAGE_DB_HOST=hydra-image-mongo
IMAGE_DB_NAME=himage
IMAGE_DB_PARAMS=?directConnection=true
