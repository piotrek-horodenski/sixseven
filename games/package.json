{
  "name": "sixseven-games",
  "version": "0.0.1",
  "description": "games — skarbiec: silnik meczów, matchmaking, trust. Kolekcje prywatne (moves, match_states, resolve_log). Szkielet (etap 0); silnik meczu w etapie 2.",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc --outDir dist --project . && node ./dist/index.js",
    "start": "nodemon -e ts --exec \"npm run compile\"",
    "build": "tsc --outDir dist ./index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.3.0",
    "mongoose": "^9.3.2",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "sixseven-hmac": "*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.2",
    "@vitest/coverage-v8": "^4.1.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
